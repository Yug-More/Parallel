APP_ENV=development
DATABASE_URL=sqlite:///./parallel.db
# Set a generated secret to keep sessions valid across restarts.
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# SECRET_KEY=
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Optional: install requirements-ai.txt before using the AI reply endpoint.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Voice, SMS, research and external tool execution have no enable switch in Phase 1A.
