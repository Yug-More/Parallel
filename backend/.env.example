APP_ENV=development
DATABASE_URL=sqlite:///./parallel.db
# Set a generated secret to keep sessions valid across restarts.
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# SECRET_KEY=
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Optional: install requirements-ai.txt before using the AI reply endpoint.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Explicit opt-ins; keep disabled until the operator intends these capabilities.
GITHUB_CONNECTOR_ENABLED=false
GROUNDED_MODEL_ENABLED=false
# Public GitHub GETs need no token. Optional model mode can incur cost.
# Voice, SMS and external repository/document writes remain disabled.
# Optional local character-similarity index; no trained embeddings or network calls.
LOCAL_INDEX_ENABLED=false
# Private GitHub App flow, separately enabled after owner configuration.
GITHUB_APP_ENABLED=false
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# CREDENTIAL_ENCRYPTION_KEY=
# Never reuse SECRET_KEY as the credential encryption key. Back up keys privately.
